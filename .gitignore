# ===== Build artifacts (huge, not committed) =====
xvc/petalinux/xvc/build/
xvc/petalinux/xvc/images/
xvc/petalinux/xvc/components/
xvc/vivado/work*/
xvc/vivado/out*/
xvc/vivado/.Xil/
xvc/vivado/.vivado-ai/
xvc/vivado/NA/
xvc/sim/__pycache__/
xvc/sim/sim_build/
**/__pycache__/
*.pyc
*.pyo

# Vivado projects / logs
*.jou
*.log
*.str
*.wdb
*.wcfg
*.dcp
*.rpt
*.pb
.Xil/
.srcs/
.tmp/
.v26home/
vivado*.backup.*
usage_statistics_webtalk.*

# Intermediate files
*.o
*.d
*.a
*.so
*.elf
*.mcs
*.prm
*.bin.bak

# ===== Historical releases (keep only v16) =====
xvc/out/*
!xvc/out/v16/
# docs inside v16 duplicate xvc/docs — do not commit twice
xvc/out/v16/docs/
xvc/out/v16/*.tar.gz
**/*.tar.gz
**/*.tar.xz
**/*.zip

# ===== Reference material (large / vendor copyright) =====
references/
*.pdf

# ===== Test bitstreams (large, user-supplied) =====
test_bits/*.bit
test_bits/*.bin
test_bits/*.mcs

# ===== Editor / OS =====
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ===== Copyright avoidance (important) =====
# 1) Text extracted from vendor documents — AMD/Xilinx copyright, not redistributed
xvc/docs/pg245.txt
xvc/docs/xapp1251.txt
xvc/docs/kb-xvc-usplus.txt
*.mhtml
*.pdf

# 2) Vivado project files (carry Xilinx copyright headers; also build artifacts)
*.xpr
*.xpr.bak*
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.cache/
*.gen/

# 3) Zynq PS init code — auto-generated by Xilinx; *_gpl.* is explicitly GPL;
#    PetaLinux regenerates it from the XSA, so it is not committed
ps7_init*
xvc/petalinux/xvc/project-spec/hw-description/*.json
xvc/petalinux/xvc/project-spec/hw-description/metadata

# 4) Bootable images — embed the Linux kernel, busybox and other GPL components;
#    distributing the binary requires the complete source. This repo ships the BUILD
#    sources; get binaries from Releases (which links back to the source).
xvc/out/v16/sd_card/BOOT.BIN
xvc/out/v16/sd_card/image.ub

# ===== Release binaries (distributed via GitHub Releases, not git history) =====
release/v16/
release/*.tar.gz

# build-time credentials, never committed
xvc/petalinux/xvc/project-spec/meta-user/conf/secret.conf
