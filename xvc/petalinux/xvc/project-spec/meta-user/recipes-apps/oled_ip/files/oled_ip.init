#!/bin/sh
DAEMON=/usr/bin/oled_ip
PIDFILE=/var/run/oled_ip.pid
ARGS="-b /dev/i2c-1 -a 0x3c -i eth0"

start() {
    echo -n "Starting oled_ip: "
    start-stop-daemon -S -q -x $DAEMON -b -m -p $PIDFILE -- $ARGS
    echo "done"
}
stop() {
    echo -n "Stopping oled_ip: "
    start-stop-daemon -K -q -p $PIDFILE
    echo "done"
}
case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
